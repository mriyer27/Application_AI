# Copy to .env (`job-agent init` does this) and keep it private: chmod 600 .env
# Never commit .env. Values here are placeholders only.

# Optional: where the project lives (defaults to the current directory)
# JOB_AGENT_HOME=/path/to/Application_AI

# Dashboard login. Set with: job-agent dashboard set-password
JOB_AGENT_DASHBOARD_USERNAME='<choose-a-username>'
JOB_AGENT_DASHBOARD_PASSWORD_HASH='<generated-by-job-agent-dashboard-set-password>'

# Random secret for signing dashboard sessions (job-agent init generates one)
JOB_AGENT_SESSION_SECRET='<generated-random-secret>'

# Optional: contact email appended to the HTTP User-Agent for job-board APIs
# JOB_AGENT_CONTACT_EMAIL='<you@example.com>'
